# Every environment variable the project uses, with what it is for.
# Copy to .env.local for local work. Never commit real values.

# The public address of the site, used for canonical links, the sitemap, robots.txt and share images.
# The domain is not chosen yet. Set it to the real address (no trailing slash) before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email used as the user name for the SILO weather service (milestone 1.4).
# SILO contacts users through it. Claudia has chosen the address; it is not kept in the repo.
SILO_CONTACT_EMAIL=

# Builders' pages under /dev (the map's test page). They always work in `pnpm dev`.
# In a production build they return 404 unless this is set to 1. Leave it unset on the live site.
GG_DEV_PAGES=

# Where the game server keeps farm files. Defaults to apps/web/.farms (git ignores it).
GG_FARMS_DIR=

# The header a trusted proxy in front of the app sets to the caller's address, used to
# limit how many farms one address can start (for example x-real-ip on Vercel).
# Leave it unset unless the app really sits behind such a proxy: a client can write any
# header it likes, so with it unset no header is trusted and every caller with no session
# shares one limit (5 farms in 10 minutes for everyone). In production the server logs a
# warning at start-up when it is unset. For x-forwarded-for the last entry (the proxy's) is used.
GG_TRUSTED_IP_HEADER=

# The address for enquiries shown on the website: the Advertise page, privacy, terms and community
# rules, and the footer. Claudia chooses it; it is never kept in the repo. While it is unset, the
# website leaves every "contact us" link out and shows "Contact details will be added before
# launch." in the draft pages. Read when the site is built, so changing it needs a rebuild.
SITE_CONTACT_EMAIL=

# Who "we" is on the privacy page and the terms: the name of the business that owns the game.
# Claudia decides it (her own business or AgriProve, PRD 18); it is never kept in the repo.
# While it is unset, those pages say "the owner of The Grazing Game" and show a plain
# "Contact details will be added before launch." line.
SITE_OWNER_NAME=

# Which parts of the game the public pages may talk about. A comma-separated list of switch keys
# from packages/shared (community, leaderboards, daily_farm, purchases, signups_open, ads,
# banner_ads, video_ads, feed_posts, sheep, farm_hands, analytics). Everything is OFF while this is
# unset, so the live pages never promise what is not built. Turn a key on only when that part
# is live. The public pages are built to static files, so this is read WHEN THE SITE IS BUILT:
# changing it needs a new build (a redeploy). Stage 5 replaces this with the live switches from
# the admin back end.
SITE_SWITCHES_ON=
# ---- Supabase (milestone 3.1). Claudia makes the project (Free plan, Sydney region) and
# copies these from the Supabase dashboard (Project Settings, API keys and Database).
# The database tables, rules and functions are in supabase/migrations (docs/DATABASE.md).

# The project's address, for example https://abcdefghijkl.supabase.co. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (older projects call it the anon key). Safe in the browser: every
# table it can reach is guarded by row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (older projects call it the service role key). SERVER ONLY. It passes
# every access rule, so it must never have a NEXT_PUBLIC_ name or reach the browser.
# The game server uses it to read and write farm saves, scores and leaderboards.
SUPABASE_SECRET_KEY=

# The database connection string (Database, Connection string, URI), used only to apply
# the migrations from a developer machine or CI. Never used by the running site.
SUPABASE_DB_URL=

# The POOLED database connection string (Database, Connection string, "Transaction pooler"
# or "Session pooler", URI) (milestone 3.2). SERVER ONLY, with the database password in it.
# The game server keeps farm saves, the diary and the day-by-day history through this connection.
# Set it, with the Supabase keys above and BAN_HASH_PEPPER, and accounts and database saves turn
# on. Left unset, the game runs with guest play and farm files (GG_FARMS_DIR), and sign-in is
# simply not offered. Use the pooler address, not the direct one: a hosted site opens many short
# connections.
SUPABASE_DB_POOLER_URL=

# The site's own public address, for example https://thegrazinggame.example (milestone 3.2).
# Optional. Sign-in links come back to the address the request arrived on; set this to pin it
# (for example behind a proxy that rewrites the host). It must be a plain origin with no path,
# and the same address you list as a redirect URL in the Supabase dashboard.
GG_SITE_URL=

# A long random secret (the "pepper") for the ban list. SERVER ONLY, never in the database
# or the repo. The server hashes a normalised sign-in email as HMAC-SHA-256 with this key and
# gives the database only the finished hash (docs/DATABASE.md, "The ban list"). Without it the
# ban list can't be read or checked. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every existing ban record stop matching (see DATABASE.md before rotating).
BAN_HASH_PEPPER=

# ---- Email (milestone 3.1). Claudia makes a Resend account and verifies the domain.
# Sign-in links go through Supabase Auth's SMTP settings, which use this key there; the
# server uses it here for alerts. Server only.
RESEND_API_KEY=
