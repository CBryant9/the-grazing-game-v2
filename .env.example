# Every environment variable the project uses, once each, with what it is for, grouped by service.
# Copy to .env.local for local work. Never commit real values. Every one may be left empty: the game
# then runs with guest play and farm files, and each part that needs a key says plainly it is not
# set up (nothing is for sale, no ad shows, nothing asks for notification permission).

# ======================================================================== The site and the game

# The public address of the site, used for canonical links, the sitemap, robots.txt and share images.
# The domain is not chosen yet. Set it to the real address (no trailing slash) before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The site's own public address for the server, for example https://thegrazinggame.example
# (milestone 3.2). REQUIRED for accounts in production: without it accounts stay off, and the server
# says why at start-up. Every sign-in link, redirect, email link and the Stripe return pages are
# built from it, never from the Host header. A plain origin with no path, the same address you list
# as a redirect URL in the Supabase dashboard. (On a developer's machine the request's address is used.)
GG_SITE_URL=

# Where the game server keeps farm files when there is no database. Defaults to apps/web/.farms
# (git ignores it).
GG_FARMS_DIR=

# Game feature switches to turn on when there is NO database (farm files, a local check only),
# comma separated: for example `sheep`. Ignored whenever a database is set: the admin's switches
# rule there. Leave it unset on the live site.
GG_SWITCHES_ON=

# Builders' pages under /dev (the map's test page). They always work in `pnpm dev`. In a production
# build they return 404 unless this is set to 1. Leave it unset on the live site.
GG_DEV_PAGES=

# The header a trusted proxy in front of the app sets to the caller's address (for example
# x-real-ip on Vercel), used for every per-address limit. Leave it unset unless the app really sits
# behind such a proxy: a client can write any header it likes, so with it unset no header is trusted
# and every caller with no session shares one limit. In production the server logs a warning at
# start-up when it is unset. For x-forwarded-for the last entry (the proxy's) is used.
GG_TRUSTED_IP_HEADER=

# ======================================================================== The public website

# The address for enquiries shown on the website (Advertise, privacy, terms, community rules, the
# footer). Claudia chooses it; it is never kept in the repo. Unset, every "contact us" link is left
# out and the draft pages say "Contact details will be added before launch." Read when the site is
# built, so changing it needs a rebuild.
SITE_CONTACT_EMAIL=

# Who "we" is on the privacy page and the terms: the business that owns the game. Claudia decides it
# (PRD 18); it is never kept in the repo. Unset, those pages say "the owner of The Grazing Game".
SITE_OWNER_NAME=

# Which parts of the game the public pages may talk about: a comma-separated list of switch keys
# from packages/shared (community, leaderboards, daily_farm, purchases, signups_open, ads,
# banner_ads, video_ads, feed_posts, sheep, farm_hands, analytics). Everything is OFF while unset, so
# the live pages never promise what is not built. Read WHEN THE SITE IS BUILT (a redeploy to change).
SITE_SWITCHES_ON=

# ======================================================================== Supabase (milestones 3.1, 3.2)
# Claudia makes the project (Free plan, Sydney region) and copies these from the dashboard (Project
# Settings, API keys and Database). Tables, rules and functions: supabase/migrations (docs/DATABASE.md).

# The project's address, for example https://abcdefghijkl.supabase.co. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (older projects call it the anon key). Safe in the browser: every table it can
# reach is guarded by row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (older projects call it the service role key). SERVER ONLY: it passes every access
# rule, so it must never have a NEXT_PUBLIC_ name. The server uses it for saves, scores, Storage
# (ad media, community photos) and sign-in administration.
SUPABASE_SECRET_KEY=

# The direct database connection string (Database, Connection string, URI), used only to apply the
# migrations from a developer machine or CI. Never used by the running site.
SUPABASE_DB_URL=

# The POOLED connection string (Database, Connection string, "Transaction pooler" or "Session
# pooler", URI). SERVER ONLY, with the database password in it. Set it, with the Supabase keys above
# and BAN_HASH_PEPPER, and accounts and database saves turn on (and with them Daily Farm, ads,
# purchases, notifications and the community, each still behind its admin switch). Left unset, the
# game runs with guest play and farm files.
SUPABASE_DB_POOLER_URL=

# A long random secret (the "pepper"). SERVER ONLY, never in the database or the repo. Used to hash
# sign-in emails for the ban list (docs/DATABASE.md, "The ban list") and to sign ad impressions.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every existing ban record stop matching (see DATABASE.md before rotating).
BAN_HASH_PEPPER=

# ======================================================================== Scheduled jobs (milestones 3.3, 3.4)

# The secret both scheduled routes check: the Daily Farm rollover (/api/daily/rollover, every 15
# minutes) and the notifications sender (/api/notify/send, every 5 minutes). SERVER ONLY. Make one the
# same way as BAN_HASH_PEPPER. On Vercel, set it as CRON_SECRET and the crons in apps/web/vercel.json
# send it as `Authorization: Bearer <secret>` by themselves. With the database scheduler instead
# (pg_cron, migrations 20261115000600_daily_cron and 20261115003000_notify_cron), store the same
# secret in Supabase Vault as `gg_cron_secret` (docs/DATABASE.md). Unset, both routes answer 404.
CRON_SECRET=

# ======================================================================== Weather and prices (SILO, MLA)

# Set to `live` to fetch each day's real weather (SILO) and prices (MLA) in the Daily Farm rollover.
# Left empty, nothing is fetched: Daily Farm then runs only as far as the days already kept.
GG_DAILY_FEED=

# The contact email SILO asks for as its user name (milestone 1.4); SILO contacts users through it.
# Claudia has chosen the address; it is never kept in the repo. MLA needs no key.
SILO_CONTACT_EMAIL=

# ======================================================================== Email (Resend)

# Claudia makes a Resend account and verifies the domain. SERVER ONLY. Sign-in links go through
# Supabase Auth's SMTP settings (which use this key there); the server uses it here for alerts and
# notification emails.
RESEND_API_KEY=

# The sender notification emails come from, on the verified domain: `Name <address>`. Email also needs
# RESEND_API_KEY, GG_SITE_URL and NOTIFY_TOKEN_SECRET.
NOTIFY_FROM_ADDRESS=

# 32 or more random characters. SERVER ONLY. It locks the unsubscribe link in each email. Make one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every unsubscribe link already sent stop working (the settings page still works).
NOTIFY_TOKEN_SECRET=

# ======================================================================== Web push (milestone 3.4)
# All server only. With these unset no push is sent, nothing asks for permission, and the settings
# page says what is not set up. The inbox works.
#
# Make a pair once with this command and paste the two lines it prints:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=k.privateKey.export({format:'jwk'});const pub=Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url');console.log('VAPID_PUBLIC_KEY='+pub);console.log('VAPID_PRIVATE_KEY='+j.d)"
# Changing the pair later stops every saved device working (players turn notifications on again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this sender: `mailto:` an address you read, or the site's https
# address. Left empty, GG_SITE_URL is used.
VAPID_SUBJECT=

# ======================================================================== Stripe (milestone 5.2)
# Claudia makes the Stripe account and STARTS IN TEST MODE (the "Test mode" switch, top right). Both
# SERVER ONLY. Nothing is for sale unless BOTH are set, accounts are on, the "purchases" switch is on
# in /admin/switches, and the product is switched on in /admin/purchases. No price id is needed.
#
# The secret key: Developers, API keys, "Secret key" (sk_test_ in test mode). A restricted key
# (rk_...) with write access to Checkout Sessions and Refunds and read access to PaymentIntents and
# Charges also works.
STRIPE_SECRET_KEY=
# The webhook signing secret: Developers, Webhooks, add an endpoint at
# https://YOUR-SITE/api/billing/webhook, send the events listed in docs/DEVELOPMENT_LOG.md
# ("m5.2 Purchases"), then reveal "Signing secret" (whsec_). Test and live mode each have their own.
STRIPE_WEBHOOK_SECRET=

# ======================================================================== Image check (milestone 4.3)
# Claudia chooses an outside image-check service (nudity and violence); its adapter is written then.
# SERVER ONLY. Until then this key does nothing: every community photo waits in the manual queue at
# /admin/photos, and nobody but its author sees a photo before an admin approves it.
IMAGE_CHECK_API_KEY=

# ======================================================================== Error reporting (Sentry, milestone 5.5)
# Claudia makes a Sentry project (platform Node.js) and copies its DSN (Settings, Client Keys).
# SERVER ONLY: no Sentry script is sent to the browser. Browser errors reach the server at
# /api/client-error and are forwarded from there. Unset, nothing is sent anywhere and nothing fails.
# Only the route, a reason code, the error's class, the release and a trimmed stack are sent.
SENTRY_DSN=

# The release name Sentry files errors under. Optional: on Vercel the commit (VERCEL_GIT_COMMIT_SHA)
# is used when this is unset. Letters, digits, dots, dashes and underscores only.
GG_RELEASE=

# ======================================================================== Analytics (PostHog, milestone 5.3)
# Claudia makes a PostHog project (Free plan) and copies these from Project settings. Both SERVER
# ONLY: the browser never loads a PostHog script. The browser sends a small beacon to our own
# /api/collect, and the server sends the events on. Nothing is counted at all until the
# "analytics" switch is on in /admin/switches, and then only for people who said yes on the
# consent control (never an account under 16). With either of these unset, events are counted in
# our own database only and nothing leaves the server. Ids sent are a random id per browser or the
# account id hashed with BAN_HASH_PEPPER; never an email, a username or an address.
#
# The project API key (starts phc_). It is a write-only key, but it is kept server side all the same.
POSTHOG_KEY=
# The PostHog address for your region, https only, no trailing slash, for example
# https://us.i.posthog.com or https://eu.i.posthog.com.
POSTHOG_HOST=
