# Every environment variable the project uses, with what it is for.
# Copy to .env.local for local work. Never commit real values.

# The public address of the site, used for links, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email used as the user name for the SILO weather service (milestone 1.4).
# SILO contacts users through it. Claudia has chosen the address; it is not kept in the repo.
SILO_CONTACT_EMAIL=

# Builders' pages under /dev (the map's test page). They always work in `pnpm dev`.
# In a production build they return 404 unless this is set to 1. Leave it unset on the live site.
GG_DEV_PAGES=

# Where the game server keeps farm files. Defaults to apps/web/.farms (git ignores it).
GG_FARMS_DIR=

# The header a trusted proxy in front of the app sets to the caller's address, used to
# limit how many farms one address can start (for example x-real-ip on Vercel).
# Leave it unset unless the app really sits behind such a proxy: a client can write any
# header it likes, so with it unset no header is trusted and every caller with no session
# shares one limit. For x-forwarded-for the last entry (the proxy's) is used.
GG_TRUSTED_IP_HEADER=
